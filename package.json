{
  "name": "rcs-context",
  "version": "0.1.26",
  "type": "module",
  "description": "RCS — cut the repeated per-turn context cost of a long coding session, and give the model a read-only verifier. DeepSeek Harness plugin bundle (context compression + external reasoning + append-only transcript + web panel).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-management",
    "llm-agent"
  ],
  "files": [
    "web",
    "condense",
    "toolfold",
    "contextinjector-webui",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.txt",
    "docs"
  ],
  "exports": {
    ".": "./web/contextinjector.mjs",
    "./web/*": "./web/*",
    "./condense/*": "./condense/*",
    "./toolfold/*": "./toolfold/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
