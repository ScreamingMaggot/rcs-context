{
  "name": "rcs-context",
  "version": "0.1.39",
  "description": "RCS — fold repeated tool output without losing the original, give the model a read-only verifier, and externalize session facts into auditable memory. DeepSeek Harness plugin bundle: context folding, external reasoning, append-only transcript, and external memory with rcs:// addressing, L0/L1/L2 layers, directory-aware search, retrieval traces, a deterministic durability gate, host-verified semantic proposals, and a file-state janitor. Compatible with DSH 0.1.5-rc.2 through 0.2.1-rc.3. MIT.",
  "type": "module",
  "main": "./web/contextinjector.mjs",
  "exports": {
    ".": "./web/contextinjector.mjs",
    "./web/*": "./web/*",
    "./condense/*": "./condense/*",
    "./toolfold/*": "./toolfold/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "web",
    "condense",
    "toolfold",
    "contextinjector-webui",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-management",
    "context-compression",
    "context-engineering",
    "llm-agent",
    "external-memory",
    "agent-memory",
    "semantic-memory",
    "ledger",
    "retrieval",
    "provenance",
    "auditability",
    "sqlite",
    "observability"
  ],
  "license": "MIT",
  "author": "ScreamingMaggot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScreamingMaggot/rcs-context.git"
  },
  "homepage": "https://github.com/ScreamingMaggot/rcs-context#readme",
  "bugs": {
    "url": "https://github.com/ScreamingMaggot/rcs-context/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
