{
  "name": "rcs-context",
  "version": "0.1.27",
  "description": "RCS — cut the repeated per-turn context cost of a long coding session, and give the model a read-only verifier. DeepSeek Harness plugin bundle (context compression + external reasoning + append-only transcript + web panel).",
  "type": "module",
  "main": "./web/contextinjector.mjs",
  "exports": {
    ".": "./web/contextinjector.mjs",
    "./web/*": "./web/*",
    "./condense/*": "./condense/*",
    "./toolfold/*": "./toolfold/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "web",
    "condense",
    "toolfold",
    "contextinjector-webui",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-management",
    "llm-agent"
  ],
  "license": "MIT",
  "author": "ScreamingMaggot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScreamingMaggot/rcs-context.git"
  },
  "homepage": "https://github.com/ScreamingMaggot/rcs-context#readme",
  "bugs": {
    "url": "https://github.com/ScreamingMaggot/rcs-context/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
